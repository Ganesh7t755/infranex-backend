# ==============================================================================
# InfraNex AI Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development overrides (do not commit .env).
# In production (e.g., Vercel / Cloud Run), configure these in your host dashboard.

# ------------------------------------------------------------------------------
# 1. Application Runtime Mode
# ------------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development
DEBUG=True

# Server Host & Port (Local Uvicorn development server)
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Local Development (SQLite file inside backend directory):
DATABASE_URL=sqlite:///./infranex_dev.db

# Production (Managed PostgreSQL with connection pooling, e.g., Neon / Supabase):
# Note: Use pooled connection strings (PgBouncer mode) for serverless environments.
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/infranex?sslmode=require

# ------------------------------------------------------------------------------
# 3. Authentication & Cryptography
# ------------------------------------------------------------------------------
# Cryptographic signing secret for JWT access tokens (HS256).
# In production, generate a secure random 64-char key (e.g., `openssl rand -hex 32`).
JWT_SECRET_KEY=replace-with-a-secure-random-64-character-jwt-secret-key

# Development Simulation Header Tokens (ignored when ENVIRONMENT=production)
DEV_REVIEWER_TOKEN=infranex-dev-reviewer-secret-key-stage5
DEV_AUTHORITY_TOKEN=infranex-dev-authority-secret-key-stage3

# ------------------------------------------------------------------------------
# 4. File & Evidence Storage
# ------------------------------------------------------------------------------
# Local Development: Stores files in the local filesystem under backend/uploads/
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Production Cloud Object Storage (Future S3-compatible: Cloudflare R2 / AWS S3):
# STORAGE_BACKEND=s3
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=infranex-evidence-production
# STORAGE_ACCESS_KEY=your-storage-access-key-id
# STORAGE_SECRET_KEY=your-storage-secret-access-key
# STORAGE_REGION=auto

# ------------------------------------------------------------------------------
# 5. AI Incident Assessment & Verification
# ------------------------------------------------------------------------------
# Local options:
#   clip  - Uses local offline CLIP weights if present in models/clip/
#   mock  - Uses deterministic simulation provider (recommended for tests/CI)
AI_PROVIDER=clip
AUTO_ASSESS_ON_UPLOAD=True
MOCK_CONFIDENCE_THRESHOLD=0.75

# Production External Inference (Decoupled Microservice or Cloud Vision API):
# EXTERNAL_INFERENCE_URL=https://infranex-inference-worker.internal/assess
# EXTERNAL_INFERENCE_API_KEY=your-external-inference-api-key
# GEMINI_API_KEY=your-gemini-vision-api-key

# ------------------------------------------------------------------------------
# 6. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated allowed origins (Android emulators, local web portals, etc.)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000
